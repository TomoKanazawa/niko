#!/bin/sh
# Runs the sandbox command from a clone of this repository, from any folder:
#   /path/to/niko/bin/niko doctor
# The tool keeps its files in ./.niko of the folder you run it from.
DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [ ! -f "$DIR/packages/niko/dist/cli.js" ]; then
  echo "niko: not built yet. Run: (cd $DIR && pnpm install && pnpm build)" >&2
  exit 1
fi
exec node "$DIR/packages/niko/dist/cli.js" "$@"
